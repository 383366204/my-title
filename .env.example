# 所有 LLM 功能共用此配置（灵感选词、标题生成等）
# 支持 glm、volc、deepseek、minimax、openai-compatible
LLM_PROVIDER=minimax
LLM_API_KEY=your_llm_api_key_here
LLM_API_BASE=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M3
# 请求超时（毫秒）
# LLM_TIMEOUT=30000
# LLM_LONG_TIMEOUT=60000
# 灵感选词请求单独超时，默认 180 秒；逐条分析，已完成结果可续用
# INSPIRATION_LLM_TIMEOUT_MS=180000
# 灵感节点模型默认继承 LLM_MODEL；M3 默认关闭思考，不影响标题生成
# INSPIRATION_LLM_MODEL=MiniMax-M3
# INSPIRATION_LLM_THINKING=disabled
# INSPIRATION_LLM_CONCURRENCY=2
# INSPIRATION_MATERIAL_BUDGET=48

# Gemini API key (optional, used for Google Gemini integrations)
# GEMINI_API_KEY=your_gemini_api_key_here

# 1688 AI 版 Access Key (从 1688 AI 店长 APP 获取)
# 格式: 前 32 字符是 Secret，剩余是 KeyID
ALI_1688_AK=your_1688_access_key_here
# 1688 API defaults to direct connections; set system to use HTTP(S)_PROXY.
ALI1688_PROXY_MODE=direct

# taobao-native CLI (可选依赖，用于淘宝同行标题搜索)
# WSL2 默认路径: /mnt/c/Users/<用户名>/AppData/Local/Programs/taobao/bin/taobao-native.cmd
# TAOBAO_NATIVE_PATH=
# TAOBAO_NATIVE_TIMEOUT=10000

# 1688 API 限流配置
API_RATE_LIMIT_MAX=20
API_RATE_LIMIT_WINDOW=60000
API_429_COOLDOWN=3600000
API_RATE_LIMIT_QUEUE_MAX=10

# 批量选品默认商品数上限（每关键词）
BATCH_DEFAULT_LIMIT=5

# 生意参谋 SYCM 登录态缓存（人工登录一次后复用）
SYCM_LOGIN_MODE=manual
# Windows 示例: C:\Users\YourUsername\AppData\Local\ecom-ai-tools-chrome
# Linux/云服务器示例: /data/ecom-ai-tools/chrome-profile/sycm
# SYCM_CHROME_PROFILE_DIR=/data/ecom-ai-tools/chrome-profile/sycm
# SYCM_REMOTE_DEBUGGING_PORT=9222

# 每日动态灵感的新闻 RSS/Atom 源（可选，多个地址用英文逗号分隔）
# 未配置时仍会使用字典与日历灵感，不会阻塞每日流水线。
# INSPIRATION_NEWS_FEEDS=https://example.com/feed.xml,https://example.com/atom.xml

# 标题生成超时（毫秒，默认 120000）
# RUN_TIMEOUT=120000

# Taobao OPC/OPT image service MCP gateway (optional, used by taobao_opc_* MCP tools)
# Copy TAOBAO_OPT_URL.url from taobao-image-optimizer/mcp-config.json.
# The real URL contains a key. Keep it local and do not commit it.
# TAOBAO_OPC_URL=
